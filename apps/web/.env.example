# Public build settings; no credentials use the VITE_ prefix.
VITE_SITE_ORIGIN=http://127.0.0.1:3000
VITE_SITE_INDEXABLE=false
# Runtime origin must match the site being visited.
SPROUT_SITE_ORIGIN=http://127.0.0.1:3000
SPROUT_MARKETING_DATABASE_ID=
SPROUT_WAITLIST_TABLE_ID=marketing_waitlist_v1
SPROUT_INQUIRIES_TABLE_ID=marketing_inquiries_v1
# Local staging access only. Hosted requests use Appwrite's ephemeral key.
SPROUT_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
SPROUT_APPWRITE_PROJECT_ID=
SPROUT_APPWRITE_API_KEY=
