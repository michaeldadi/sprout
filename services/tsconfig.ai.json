{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "contracts/**/*.ts",
    "domain/**/*.ts",
    "integrations/**/*.ts",
    "functions/**/*.ts",
    "tests/**/*.ts"
  ]
}
